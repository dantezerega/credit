# Copy to .env and adjust. All settings have safe local defaults.

# Database — SQLite for zero-infra local dev; Postgres for docker-compose.
# DATABASE_URL=sqlite:///./credit_rv.db
# DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5432/credit_rv

# Analytics tuning
ZSCORE_LOOKBACK_DAYS=252
SIGNAL_Z_THRESHOLD=2.0

# Alerting (optional — leave blank to disable)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
